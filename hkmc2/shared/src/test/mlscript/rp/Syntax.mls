import "../../mlscript-compile/Stack.mls"

open Stack

class Pair(a, b)
object Foo
object Bar
object Baz
object Qux

:ucs npc npc:elab
pattern Test(pattern A, a) = A as a
//│ pattern <<< InfixApp(Ident(A),keyword 'as',Ident(a))
//│ | pattern <<< Ident(A)
//│ | pattern >>>
//│ pattern >>>
//│ Elaborated: Transformed:
//│ >    pattern = NonTerminal:
//│ >      symbol = A
//│ >      patternParameters = Nil
//│ >      subPatterns = Nil
//│ >    extracts = Vector of 
//│ >      Path of $

:e
pattern Test(a) = Int as b
//│ ╔══[ERROR] Unknown extraction name: b
//│ ║  l.29: 	pattern Test(a) = Int as b
//│ ╙──      	                         ^

:todo
pattern Test = Int as b
//│ /!!!\ Uncaught error: java.lang.IllegalArgumentException: requirement failed

:e
pattern Test(a) = a(Foo)
//│ ╔══[ERROR] Extraction variables cannot have parameters.
//│ ║  l.39: 	pattern Test(a) = a(Foo)
//│ ╙──      	                  ^

:e
pattern Test = Pair(Int)
//│ ╔══[ERROR] The class `Pair` expected 2 arguments.
//│ ║  l.8: 	class Pair(a, b)
//│ ║       	      ^^^^
//│ ╟── But only 1 sub-pattern is given.
//│ ║  l.45: 	pattern Test = Pair(Int)
//│ ╙──      	                    ^^^

:ucs npc:elab
pattern Test = Pair(x, y) => x + y
//│ Elaborated: Transformed:
//│ >    pattern = Constructor:
//│ >      symbol = class:Pair
//│ >      subPatterns = Vector of 
//│ >        Wildcard
//│ >        Wildcard
//│ >    extracts = Vector of 
//│ >      Path of 0 -> $
//│ >      Path of 1 -> $

:e
