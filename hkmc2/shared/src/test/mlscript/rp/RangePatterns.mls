:e
pattern BadRange = "s"..=0
//│ ╔══[ERROR] Range bounds must be of the same type.
//│ ║  l.112: 	pattern BadRange = "s"..=0
//│ ╙──       	                   ^^^^^^^
//│ ╔══[ERROR] Incompatible range types: string literal to integer literal
//│ ║  l.112: 	pattern BadRange = "s"..=0
//│ ╙──       	                   ^^^^^^^

// It becomes an absurd pattern.
0 is BadRange
//│ = false

:e
