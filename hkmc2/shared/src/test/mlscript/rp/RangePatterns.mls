:js

pattern Lower = "a"..="z"

"a" is Lower
//│ = true

"z" is Lower
//│ = true

"0" is Lower
//│ = false

"a" is @compile Lower
//│ = true

"z" is @compile Lower
//│ = true

"0" is @compile Lower
//│ = false

pattern Upper = "A"..="Z"

"A" is Upper
//│ = true

"Q" is Upper
//│ = true

"b" is Upper
//│ = false

"A" is @compile Upper
//│ = true

"Q" is @compile Upper
//│ = true

"b" is @compile Upper
//│ = false

pattern UnsignedShort = 0 ..< 65536

0 is UnsignedShort
//│ = true

0 is @compile UnsignedShort
//│ = true

-1 is UnsignedShort
//│ = false

-1 is @compile UnsignedShort
//│ = false

65535 is UnsignedShort
//│ = true

65535 is @compile UnsignedShort
//│ = true

65536 is UnsignedShort
//│ = false

65536 is @compile UnsignedShort
//│ = false

2147483647 is UnsignedShort
//│ = false

2147483647 is @compile UnsignedShort
//│ = false

"b" is UnsignedShort
//│ = false

"b" is @compile UnsignedShort
//│ = false

// The empty array ([]) is converted to a primitive using toString(), resulting
// in "". Then, the empty string is then converted to 0 when used in a numeric
// comparison. That's why `0 <= []` is true. The same applies to `[] < 65536`.

[] is UnsignedShort
//│ = true

[] is @compile UnsignedShort
//│ = true

