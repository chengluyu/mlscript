pattern Arbitrary0 =
  (Pair(Pair(x, y), Pair(a, b)) => x * y + a * b) |
  (Pair(k,          Pair(p, q)) => k * (p + q)  ) |
  (Pair(Pair(_, _), _         ) => 42           ) |
  (Pair(m,          n         ) => m * n        )

:ucs npc
