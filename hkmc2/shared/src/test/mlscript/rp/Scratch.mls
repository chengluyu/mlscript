pattern Arbitrary2 =
  (Pair(A, Triplet(_, A, c)) => c * 2) |
  (Pair(B, Triplet(a, B, _)) => a * 3)
// (Pair(C, Triplet(_, b, _)) => b * 5)

:ucs npc
