pattern Arbitrary2 =
  (Pair(A, Triplet(_, _, c)) => c * 2) |
  (Pair(B, Triplet(a, _, _)) => a * 3) |
  (Pair(C, Triplet(_, b, _)) => b * 5)

:ucs npc
:sjs
fun test5(x) = if x is @compile Arbitrary2 then 42 else 100
