pattern Arbitrary1 =
  (Pair(A, Pair(Pair(a, _), Pair(_, c))) => (a + c) * 2) |
  (Pair(B, Pair(Pair(_, u), v)) => (u + v) * 3) |
  (Pair(C, Pair(p, Pair(q, _))) => (p + q) * 5)

:ucs npc
fun test4(x) = if x is @compile Arbitrary1 then 42 else 100
//│ compile <<< Arbitrary1
