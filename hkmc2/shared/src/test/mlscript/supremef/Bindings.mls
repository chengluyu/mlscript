let id(x) = x in id
//│ Parsed Core Term: let id = λx. x in id
//│ Inferred: id
//│ As term: let id = λx -> x in id
//│ |> id, ∀^m2 x. x -> x ≤ id, id ≤ ⚫
//│ ====== (1) ======
//│ Constr: id
//│ Rule: C-Promote
//│ Remaining: 2
//│ ====== (2) ======
//│ Constr: ∀^m2 x. x -> x ≤ id
//│ Rule: C-Var2
//│ Remaining: 1
//│ ====== (3) ======
//│ Constr: id ≤ ⚫
//│ Rule: C-Unwrap
//│ |> id ≤ ⚫
//│ Remaining: 1
//│ ====== (4) ======
//│ Constr: id ≤ ⚫
//│ Rule: C-Var1
//│ |> ∀^m2 x0. x0 -> x0 ≤ ⚫
//│ Remaining: 1
//│ ====== (5) ======
//│ Constr: ∀^m2 x0. x0 -> x0 ≤ ⚫
//│ Rule: C-Forall1
//│ |> x0 -> x0 ≤ ⚫
//│ [m3,m2]
//│   -> ∀^m2 x0. x0 -> x0
//│ Remaining: 1
//│ ====== (6) ======
//│ Constr: x0 -> x0 ≤ ⚫
//│ Rule: C-FunForce
//│ Remaining: 0
//│ ====== Final ======
//│ ------ Resolved Weak Types ------
//│ x0 -> x0
//│ -------- UBS --------
//│ id ≤^[m3] ⚫
//│ -------- LBS --------
//│ id ≥^ ∀^m2 x. x -> x
//│ ---------------------

